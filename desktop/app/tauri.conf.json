{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bel Sekolah",
  "version": "0.1.0",
  "identifier": "id.mutiarahati.belsekolah",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bel Sekolah - Mutiara Hati",
        "width": 1280,
        "height": 800,
        "resizable": true
